# Copy to .env and fill in. The server reads it on start.

# 1 = canned emails, transcript and draft; no keys needed.
MOCK=0

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:8787/auth/google/callback
# Enable the Gmail API and Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# https://console.deepgram.com → API keys (speech-to-text)
DEEPGRAM_API_KEY=

# Only if the server is not reached at http://localhost:8787 (must match the redirect URI above).
# PUBLIC_URL=
# PORT=8787
